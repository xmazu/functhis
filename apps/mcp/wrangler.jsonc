{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "functhis-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "CONSOLE_URL": "http://localhost:3002",
    "MCP_RESOURCE": "http://localhost:3003",
  },
  "observability": {
    "enabled": true,
  },
  "dev": {
    "inspector_port": 9231,
    "port": 3003,
  },
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000-0000-0000-0000-000000000001",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "BUNDLES",
      "id": "00000000-0000-0000-0000-000000000030",
    },
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "functhis_executions",
    },
  ],
  "env": {
    "preview": {
      "name": "functhis-mcp-preview",
      "workers_dev": false,
      "vars": {
        "CONSOLE_URL": "https://console.preview.functhis.now",
        "MCP_RESOURCE": "https://mcp.preview.functhis.now",
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "00000000-0000-0000-0000-000000000010",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "BUNDLES",
          "id": "00000000-0000-0000-0000-000000000010",
        },
      ],
      "worker_loaders": [
        {
          "binding": "LOADER",
        },
      ],
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "functhis_executions_preview",
        },
      ],
    },
    "production": {
      "name": "functhis-mcp",
      "workers_dev": false,
      "vars": {
        "CONSOLE_URL": "https://console.functhis.now",
        "MCP_RESOURCE": "https://mcp.functhis.now",
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "00000000-0000-0000-0000-000000000011",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "BUNDLES",
          "id": "00000000-0000-0000-0000-000000000011",
        },
      ],
      "worker_loaders": [
        {
          "binding": "LOADER",
        },
      ],
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "functhis_executions",
        },
      ],
    },
  },
}
