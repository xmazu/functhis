{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "functhis-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "CONSOLE_URL": "http://localhost:3001",
    "MCP_RESOURCE": "http://localhost:3003",
  },
  "observability": {
    "enabled": true,
  },
  "dev": {
    "inspector_port": 9231,
    "port": 3003,
  },
  "ai": {
    "binding": "AI",
  },
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000-0000-0000-0000-000000000001",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "BUNDLES",
      "id": "00000000-0000-0000-0000-000000000030",
    },
    {
      "binding": "HOT",
      "id": "00000000-0000-0000-0000-000000000031",
    },
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "functhis_executions",
    },
  ],
  "env": {
    "production": {
      "name": "functhis-mcp",
      "workers_dev": false,
      "ai": {
        "binding": "AI",
      },
      "vars": {
        "CONSOLE_URL": "https://functhis.now",
        "MCP_RESOURCE": "https://mcp.functhis.now",
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "f6ae8acd7b2d4fd482a28814268bc294",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "BUNDLES",
          "id": "583070bd016648c49f336a40288c7c9c",
        },
        {
          "binding": "HOT",
          "id": "11d66c1cea1a496fa6e282607ee4a797",
        },
      ],
      "worker_loaders": [
        {
          "binding": "LOADER",
        },
      ],
      "secrets_store_secrets": [
        {
          "binding": "FUNCTHIS_SECRETS_KEY",
          "store_id": "fdcdd40afc4d41fbbc9f6ffbe99fce77",
          "secret_name": "FUNCTHIS_SECRETS_KEY",
        },
      ],
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "functhis_executions",
        },
      ],
    },
  },
}
