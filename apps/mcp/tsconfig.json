{
  "extends": "@functhis/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@functhis/core/mcp": ["../../packages/core/src/mcp/index.ts"],
      "@functhis/core/publish": ["../../packages/core/src/publish/index.ts"],
      "@functhis/core/runtime": ["../../packages/core/src/runtime/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "cloudflare-env.d.ts"],
  "exclude": ["src/**/*.test.ts"]
}
