# Local Worker secrets for apps/web. Copy to apps/web/.env.
# Wrangler and the Cloudflare Vite plugin load this file next to wrangler.jsonc.
# Public URLs also have defaults in wrangler.jsonc `vars`.

NODE_ENV=development
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
CLOUDFLARE_ACCOUNT_ID=
ANALYTICS_ENGINE_READ_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DEVELOPER_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRO_PRICE_ID=
FUNCTHIS_SECRETS_KEY=
TRUSTED_ORIGINS=http://localhost:3001,http://localhost:3003,https://functhis.now,https://mcp.functhis.now
AXIOM_API_TOKEN=
