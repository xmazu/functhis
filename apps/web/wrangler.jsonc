{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "functhis-web",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "./src/worker-entry.ts",
  "observability": {
    "enabled": true,
  },
  "dev": {
    "inspector_port": 9229,
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000-0000-0000-0000-000000000001",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "BUNDLES",
      "id": "00000000-0000-0000-0000-000000000030",
    },
    {
      "binding": "HOT",
      "id": "00000000-0000-0000-0000-000000000031",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "functhis-artifacts",
    },
  ],
  "vars": {
    "NODE_ENV": "development",
    "BETTER_AUTH_URL": "http://localhost:3001",
    "MCP_RESOURCE": "http://localhost:3003",
    "TRUSTED_ORIGINS": "http://localhost:3001,http://localhost:3003,https://functhis.now,https://mcp.functhis.now",
  },
  "env": {
    "production": {
      "name": "functhis-web",
      "compatibility_date": "2026-09-25",
      "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "f7e6cd5d351c461698d107c6c4232f2c",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "BUNDLES",
          "id": "583070bd016648c49f336a40288c7c9c",
        },
        {
          "binding": "HOT",
          "id": "11d66c1cea1a496fa6e282607ee4a797",
        },
      ],
      "r2_buckets": [
        {
          "binding": "ARTIFACTS",
          "bucket_name": "functhis-artifacts-production",
        },
      ],
      "secrets_store_secrets": [
        {
          "binding": "BETTER_AUTH_SECRET",
          "store_id": "fdcdd40afc4d41fbbc9f6ffbe99fce77",
          "secret_name": "BETTER_AUTH_SECRET",
        },
        {
          "binding": "GITHUB_CLIENT_ID",
          "store_id": "fdcdd40afc4d41fbbc9f6ffbe99fce77",
          "secret_name": "GITHUB_CLIENT_ID",
        },
        {
          "binding": "GITHUB_CLIENT_SECRET",
          "store_id": "fdcdd40afc4d41fbbc9f6ffbe99fce77",
          "secret_name": "GITHUB_CLIENT_SECRET",
        },
        {
          "binding": "STRIPE_SECRET_KEY",
          "store_id": "fdcdd40afc4d41fbbc9f6ffbe99fce77",
          "secret_name": "STRIPE_SECRET_KEY",
        },
        {
          "binding": "STRIPE_WEBHOOK_SECRET",
          "store_id": "fdcdd40afc4d41fbbc9f6ffbe99fce77",
          "secret_name": "STRIPE_WEBHOOK_SECRET",
        },
        {
          "binding": "STRIPE_PRO_PRICE_ID",
          "store_id": "fdcdd40afc4d41fbbc9f6ffbe99fce77",
          "secret_name": "STRIPE_PRO_PRICE_ID",
        },
      ],
      "vars": {
        "NODE_ENV": "production",
        "BETTER_AUTH_URL": "https://functhis.now",
        "MCP_RESOURCE": "https://mcp.functhis.now",
        "TRUSTED_ORIGINS": "https://functhis.now,https://mcp.functhis.now",
      },
    },
  },
}
