{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "functhis-web",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker-entry.ts",
  "observability": {
    "enabled": true,
  },
  "dev": {
    "inspector_port": 9229,
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000-0000-0000-0000-000000000001",
    },
  ],
  "ai": {
    "binding": "AI",
  },
  "kv_namespaces": [
    {
      "binding": "BUNDLES",
      "id": "00000000-0000-0000-0000-000000000030",
    },
  ],
  "vars": {
    "NODE_ENV": "development",
    "CONSOLE_URL": "http://localhost:3002",
    "INTERNAL_EXECUTE_TOKEN": "dev-internal-execute",
  },
  "services": [
    {
      "binding": "MCP",
      "service": "functhis-mcp",
    },
  ],
  "env": {
    "preview": {
      "name": "functhis-web-preview",
      "compatibility_date": "2025-09-15",
      "compatibility_flags": ["nodejs_compat"],
      "ai": {
        "binding": "AI",
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "00000000-0000-0000-0000-000000000010",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "BUNDLES",
          "id": "00000000-0000-0000-0000-000000000010",
        },
      ],
      "vars": {
        "NODE_ENV": "production",
        "CONSOLE_URL": "https://console.preview.functhis.now",
        "INTERNAL_EXECUTE_TOKEN": "preview-internal-execute",
      },
      "services": [
        {
          "binding": "MCP",
          "service": "functhis-mcp-preview",
        },
      ],
    },
    "production": {
      "name": "functhis-web",
      "compatibility_date": "2025-09-15",
      "compatibility_flags": ["nodejs_compat"],
      "ai": {
        "binding": "AI",
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "00000000-0000-0000-0000-000000000011",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "BUNDLES",
          "id": "00000000-0000-0000-0000-000000000011",
        },
      ],
      "vars": {
        "NODE_ENV": "production",
        "CONSOLE_URL": "https://console.functhis.now",
        "INTERNAL_EXECUTE_TOKEN": "production-internal-execute",
      },
      "services": [
        {
          "binding": "MCP",
          "service": "functhis-mcp",
        },
      ],
    },
  },
}
