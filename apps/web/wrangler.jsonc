{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "functhis-web",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "./src/worker-entry.ts",
  "observability": {
    "enabled": true,
  },
  "dev": {
    "inspector_port": 9229,
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000-0000-0000-0000-000000000001",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "BUNDLES",
      "id": "00000000-0000-0000-0000-000000000030",
    },
    {
      "binding": "HOT",
      "id": "00000000-0000-0000-0000-000000000031",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "functhis-artifacts",
    },
  ],
  "vars": {
    "NODE_ENV": "development",
    "BETTER_AUTH_URL": "http://localhost:3001",
    "MCP_RESOURCE": "http://localhost:3003",
    "TRUSTED_ORIGINS": "http://localhost:3001,http://localhost:3003,https://functhis.now,https://mcp.functhis.now",
    "INTERNAL_EXECUTE_TOKEN": "dev-internal-execute",
  },
  "services": [
    {
      "binding": "MCP",
      "service": "functhis-mcp",
    },
  ],
  "env": {
    "preview": {
      "name": "functhis-web-preview",
      "compatibility_date": "2025-09-15",
      "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "00000000-0000-0000-0000-000000000010",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "BUNDLES",
          "id": "00000000-0000-0000-0000-000000000010",
        },
        {
          "binding": "HOT",
          "id": "00000000-0000-0000-0000-000000000012",
        },
      ],
      "r2_buckets": [
        {
          "binding": "ARTIFACTS",
          "bucket_name": "functhis-artifacts-preview",
        },
      ],
      "secrets_store_secrets": [
        {
          "binding": "BETTER_AUTH_SECRET",
          "store_id": "00000000-0000-0000-0000-000000000020",
          "secret_name": "BETTER_AUTH_SECRET",
        },
        {
          "binding": "GITHUB_CLIENT_ID",
          "store_id": "00000000-0000-0000-0000-000000000020",
          "secret_name": "GITHUB_CLIENT_ID",
        },
        {
          "binding": "GITHUB_CLIENT_SECRET",
          "store_id": "00000000-0000-0000-0000-000000000020",
          "secret_name": "GITHUB_CLIENT_SECRET",
        },
      ],
      "vars": {
        "NODE_ENV": "production",
        "BETTER_AUTH_URL": "https://preview.functhis.now",
        "MCP_RESOURCE": "https://mcp.preview.functhis.now",
        "TRUSTED_ORIGINS": "https://preview.functhis.now,https://mcp.preview.functhis.now",
        "INTERNAL_EXECUTE_TOKEN": "preview-internal-execute",
      },
      "services": [
        {
          "binding": "MCP",
          "service": "functhis-mcp-preview",
        },
      ],
    },
    "production": {
      "name": "functhis-web",
      "compatibility_date": "2025-09-15",
      "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "00000000-0000-0000-0000-000000000011",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "BUNDLES",
          "id": "00000000-0000-0000-0000-000000000011",
        },
        {
          "binding": "HOT",
          "id": "00000000-0000-0000-0000-000000000013",
        },
      ],
      "r2_buckets": [
        {
          "binding": "ARTIFACTS",
          "bucket_name": "functhis-artifacts-production",
        },
      ],
      "secrets_store_secrets": [
        {
          "binding": "BETTER_AUTH_SECRET",
          "store_id": "00000000-0000-0000-0000-000000000021",
          "secret_name": "BETTER_AUTH_SECRET",
        },
        {
          "binding": "GITHUB_CLIENT_ID",
          "store_id": "00000000-0000-0000-0000-000000000021",
          "secret_name": "GITHUB_CLIENT_ID",
        },
        {
          "binding": "GITHUB_CLIENT_SECRET",
          "store_id": "00000000-0000-0000-0000-000000000021",
          "secret_name": "GITHUB_CLIENT_SECRET",
        },
      ],
      "vars": {
        "NODE_ENV": "production",
        "BETTER_AUTH_URL": "https://functhis.now",
        "MCP_RESOURCE": "https://mcp.functhis.now",
        "TRUSTED_ORIGINS": "https://functhis.now,https://mcp.functhis.now",
        "INTERNAL_EXECUTE_TOKEN": "production-internal-execute",
      },
      "services": [
        {
          "binding": "MCP",
          "service": "functhis-mcp",
        },
      ],
    },
  },
}
