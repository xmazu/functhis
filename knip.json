{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "treatConfigHintsAsErrors": false,
  "ignore": [
    "**/routeTree.gen.ts",
    "**/cloudflare-env.d.ts",
    "**/worker-configuration.d.ts",
    "examples/**",
    "packages/db/drizzle.config.ts"
  ],
  "ignoreDependencies": [
    "@cloudflare/vite-plugin",
    "@tailwindcss/vite",
    "@tanstack/react-form",
    "@tanstack/react-router-devtools",
    "@testing-library/dom",
    "@testing-library/react",
    "@vitejs/plugin-react",
    "jsdom",
    "lucide-react",
    "next-themes",
    "tailwindcss",
    "web-vitals"
  ],
  "ignoreUnresolved": [
    "./routeTree.gen",
    "scripts/check-src-coverage.ts",
    "scripts/build.ts"
  ],
  "ignoreIssues": {
    "apps/**/src/env.server.ts": ["unlisted"],
    "apps/fumadocs/src/components/mdx.tsx": ["duplicates"],
    "packages/api/src/index.ts": ["duplicates"]
  },
  "workspaces": {
    ".": {
      "entry": ["package.json", "scripts/**/*.ts"],
      "ignoreDependencies": ["zod"]
    },
    "apps/web": {
      "entry": ["src/**/*.{ts,tsx}"],
      "vite": false,
      "ignoreDependencies": ["zod"]
    },
    "packages/auth": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["zod"]
    },
    "packages/api": {
      "entry": ["src/index.ts", "src/routers/index.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "@functhis/db",
        "@orpc/client",
        "@orpc/openapi",
        "@orpc/zod",
        "zod"
      ],
      "ignoreIssues": {
        "src/index.ts": ["duplicates"]
      }
    },
    "packages/db": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["zod"]
    },
    "packages/infra": {
      "entry": ["package.json"],
      "ignoreBinaries": ["terraform"]
    },
    "packages/config": {
      "entry": ["vite.tanstack-app.ts"],
      "project": ["**/*.ts"]
    },
    "packages/cli": {
      "entry": [
        "src/cli.ts",
        "sdk/protocol.ts",
        "sdk/next.ts",
        "sdk/client.ts",
        "sdk/**/*.test.ts",
        "src/**/*.test.ts",
        "scripts/**/*.ts"
      ],
      "project": ["src/**/*.ts", "sdk/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/publish": {
      "entry": ["src/index.ts", "src/**/*.test.ts", "scripts/**/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"],
      "ignoreDependencies": ["zod"]
    },
    "packages/runtime": {
      "entry": [
        "src/index.ts",
        "src/**/*.test.ts",
        "scripts/build.ts",
        "scripts/**/*.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "apps/mcp": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "tests/integration": {
      "entry": ["src/**/*.test.ts", "scripts/**/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    }
  }
}
