{
  "name": "@functhis/api",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./context": {
      "types": "./dist/src/context.d.ts",
      "default": "./src/context.ts"
    },
    "./routers/index": {
      "types": "./dist/src/routers/index.d.ts",
      "default": "./src/routers/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check-types": "tsc -b",
    "dev": "tsc -b --watch"
  },
  "dependencies": {
    "@functhis/db": "workspace:*",
    "@orpc/client": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@functhis/config": "workspace:*",
    "typescript": "catalog:"
  }
}
