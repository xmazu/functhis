{
  "name": "@functhis/infra",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "echo 'no types'",
    "db:hyperdrive:create": "wrangler hyperdrive create functhis-auth --connection-string=\"${DATABASE_URL}\" --caching-disabled",
    "dev:workers": "wrangler dev -c ../../apps/web/wrangler.jsonc -c ../../apps/console/wrangler.jsonc",
    "db:migrate:local": "bun run --filter @functhis/db db:migrate:deploy"
  },
  "devDependencies": {
    "@functhis/config": "workspace:*",
    "typescript": "catalog:",
    "wrangler": "^4.40.2"
  }
}
