{
  "name": "@functhis/db",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./schema/auth": {
      "types": "./dist/src/schema/auth.d.ts",
      "default": "./src/schema/auth.ts"
    },
    "./schema/catalog": {
      "types": "./dist/src/schema/catalog.d.ts",
      "default": "./src/schema/catalog.ts"
    },
    "./node-postgres": {
      "types": "./dist/src/node-postgres.d.ts",
      "default": "./src/node-postgres.ts"
    },
    "./integration-migrate": {
      "types": "./dist/src/integration-migrate.d.ts",
      "default": "./src/integration-migrate.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check-types": "tsc -b",
    "db:generate": "drizzle-kit generate",
    "db:migrate:deploy": "drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@functhis/config": "workspace:*",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:",
    "varlock": "catalog:"
  }
}
