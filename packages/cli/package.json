{
  "name": "functhis",
  "version": "0.1.1",
  "description": "Publish TypeScript functions to Functhis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xmazu/functhis.git",
    "directory": "packages/cli"
  },
  "bin": {
    "functhis": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sdk/next": {
      "types": "./dist/sdk/next.d.ts",
      "default": "./dist/sdk/next.js"
    },
    "./sdk/client": {
      "types": "./dist/sdk/client.d.ts",
      "default": "./dist/sdk/client.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check-types": "tsc --noEmit",
    "dev": "bun run src/cli.ts",
    "prepack": "bun run build",
    "pack-smoke": "bun scripts/pack-smoke.ts",
    "test": "bun scripts/check-src-coverage.ts"
  },
  "dependencies": {
    "@functhis/publish": "workspace:*",
    "@functhis/runtime": "workspace:*",
    "esbuild": "^0.25.12",
    "ts-morph": "^26.0.0",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@functhis/config": "workspace:*",
    "@types/bun": "latest"
  },
  "engines": {
    "node": ">=20"
  }
}
