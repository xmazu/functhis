{
  "name": "@functhis/core",
  "version": "0.1.0",
  "description": "Functhis publish, MCP, runtime, and catalog ports (no database)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xmazu/functhis.git",
    "directory": "packages/core"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    "./mcp": {
      "types": "./src/mcp/index.ts",
      "default": "./src/mcp/index.ts"
    },
    "./publish": {
      "types": "./src/publish/index.ts",
      "default": "./src/publish/index.ts"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "bun scripts/build-runtime.ts",
    "check-types": "bun run build && tsc --noEmit",
    "prepack": "bun run build",
    "test": "bun scripts/check-src-coverage.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7",
    "evlog": "^2.28.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@types/bun": "latest",
    "esbuild": "^0.25.12",
    "typescript": "^6.0.3"
  }
}
